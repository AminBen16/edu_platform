{
  "name": "edu-api",
  "version": "1.0.0",
  "description": "Production-ready API for education platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "call ..\\admin\\node_modules\\.bin\\tsc.cmd",
    "prisma:generate": "call node_modules\\.bin\\prisma.cmd generate --schema=..\\..\\packages\\db\\schema.prisma",
    "start": "node dist/index.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate deploy",
    "test": "jest",
"test:watch":"jest --watch",
    "lint": "eslint src/**/*.ts --fix",
    "lint:strict": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pdfkit": "^0.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "../../packages/db/schema.prisma"
  }
}
