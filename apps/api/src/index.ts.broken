import express, { Express, Request, Response } from 'express';

const app: Express = express();

// Global production middleware stack
app.use(helmet());
app.use(cors({
  origin: process.env.NODE_ENV === 'production' ? ['https://edu-platform-three-sable.vercel.app', 'https://admin.example.com'] : true,
  credentials: true
}));
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true }));
app.use(generalRateLimit);
app.use(requireJWTSecret);
app.use(xssSanitize);


// Health check
app.get('/', (req: Request, res: Response) => {
  res.status(200).json({ 
    message: 'Education Platform API - Production Ready',
    version: '1.0.0',
    status: 'operational',
    timestamp: new Date().toISOString()
  });
});

// Test endpoint
app.get('/test', (req: Request, res: Response) => {
  res.status(200).json({ message: 'Test endpoint working' });
});

// API v1 check
app.get('/api/v1', (req: Request, res: Response) => {
  res.status(200).json({ message: 'API v1 available' });
});

// Mount API routes under /api/v1
app.use('/api/v1/auth', authRouter);
app.use('/api/v1/users', usersRouter);
app.use('/api/v1/classes', classesRouter);
app.use('/api/v1/lessons', lessonsRouter);
app.use('/api/v1/quizzes', quizzesRouter);
app.use('/api/v1/assignments', assignmentsRouter);
app.use('/api/v1/announcements', announcementsRouter);
app.use('/api/v1/schedule', scheduleRouter);
app.use('/api/v1/attendance', attendanceRouter);
app.use('/api/v1/chat', chatRouter);
app.use('/api/v1/notifications', notificationsRouter);

// 404 handler for unmatched routes
app.use('*', (req: Request, res: Response) => {
  res.status(404).json({
    error: 'Endpoint not found',
    message: `Cannot ${req.method} ${req.path}`
  });
});


// Global error handler
app.use(require('./middleware/errorHandler').errorHandler);

// Export for Vercel serverless
module.exports = app;

