# Production Environment Configuration
# Copy values from Neon, generate secrets, and add to Vercel Dashboard

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Source: Neon Console (https://console.neon.tech)
# Steps:
#   1. Create account (no credit card needed)
#   2. Go to Project Settings
#   3. Copy "Connection string" 
#   4. Format: postgresql://user:password@host/database?sslmode=require
#
DATABASE_URL=postgresql://your_username:your_password@your_host.neon.tech/neondb?sslmode=require

# ============================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================
# Generate secure secret:
# Linux/Mac: openssl rand -base64 32
# Windows: https://www.random.org/strings/?num=1&len=24&digits=on&loweralpha=on&upperalpha=on&unique=on
#
NEXTAUTH_SECRET=your_generated_secret_here

# Your live domain (Vercel generates this)
# Format: https://your-app.vercel.app
#
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# ============================================
# API CONFIGURATION (REQUIRED)
# ============================================
# API endpoint for server-side and client-side requests
API_URL=https://your-vercel-domain.vercel.app/api
NEXT_PUBLIC_API_URL=https://your-vercel-domain.vercel.app/api

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
# Strong random secret for token signing
# Generate: Windows/Mac/Linux terminals accept openssl rand -base64 64
#
JWT_SECRET=your_jwt_secret_here

# Token expiration (hours)
JWT_EXPIRES_IN=24

# ============================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# STORAGE CONFIGURATION (Optional - for file uploads)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# ============================================
# MONITORING (Optional - for error tracking)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ============================================
# CORS CONFIGURATION (REQUIRED)
# ============================================
# Your deployed domain
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

# ============================================
# NODE ENVIRONMENT (DO NOT CHANGE)
# ============================================
NODE_ENV=production
