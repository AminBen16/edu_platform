{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/api/src/index.ts"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/apps/api/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
