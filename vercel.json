{
  "version": 2,
  "buildCommand": "npm run build:api",
  "outputDirectory": "apps/api/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "apps/api/src/index.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/src/index.ts"
    }
  ]
}
