// =======================
// DATABASE & GENERATOR
// =======================

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// =======================
// ENUMS
// =======================

// =======================
// MODELS
// =======================

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  subjects       Subject[]
  levels         Level[]
  topics         Topic[]
  lessons        Lesson[]
  media          Media[]
  quizzes        Quiz[]
  questions      Question[]
  attempts       QuizAttempt[]
  comments       Comment[]
  announcements  Announcement[]
  chats          Chat[]
  messages       ChatMessage[]
  settings       SchoolSettings?
  classes        Class[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  attendance     Attendance[]
  schedules      Schedule[]
  liveSessions   LiveSession[]
  teachers       Teacher[]
}

model User {
  id             String    @id @default(cuid())
  schoolId       String
  role           String
  name           String
  email          String
  passwordHash   String?
  avatarUrl      String?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  studentProfile StudentProfile?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdSubjects  Subject[]
  createdLevels    Level[]
  createdTopics    Topic[]
  createdLessons   Lesson[]
  createdMedia     Media[]
  createdQuizzes   Quiz[]
  createdQuestions Question[]
  comments         Comment[]
  sentMessages     ChatMessage[]
  chats            Chat[]         @relation("ChatUsers")
  announcements    Announcement[]
  auditLogs        AuditLog[]
  taughtClasses    Class[]        @relation("ClassTeacher")
  attendedClasses  Class[]        @relation("ClassStudents")
  notifications    Notification[]
  attendance       Attendance[]
  teacher          Teacher?

  @@unique([email, schoolId])
  @@index([schoolId])
}

model StudentProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  quizAttempts QuizAttempt[]
}

model Enrollment {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  Lesson           Lesson[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  levels Level[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Level {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  subjectId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  topics  Topic[]

  @@unique([name, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  levelId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([name, levelId])
  @@index([schoolId])
  @@index([levelId])
}

model Lesson {
  id           String    @id @default(cuid())
  title        String
  description  String?
  order        Int       @default(0)
  schoolId     String
  topicId      String
  authorId     String
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  media      Media[]
  comments   Comment[]
  quizzes    Quiz[]
  Enrollment Enrollment[]

  @@index([schoolId])
  @@index([topicId])
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      String
  name      String
  size      Float
  schoolId  String
  lessonId  String?
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  author User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([lessonId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  schoolId  String
  lessonId  String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Comment[] @relation("Replies")

  @@index([schoolId])
  @@index([lessonId])
  @@index([parentId])
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  schoolId    String
  lessonId    String
  authorId    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([schoolId])
  @@index([lessonId])
}

model Question {
  id        String   @id @default(cuid())
  text      String
  options   String
  schoolId  String
  quizId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([quizId])
}

model QuizAttempt {
  id               String   @id @default(cuid())
  score            Float
  answers          String
  schoolId         String
  quizId           String
  studentProfileId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([quizId])
  @@index([studentProfileId])
}

model Announcement {
  id        String   @id @default(cuid())
  content   String
  schoolId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Chat {
  id        String   @id @default(cuid())
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users    User[]        @relation("ChatUsers")
  messages ChatMessage[]

  @@index([schoolId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("TEXT") // TEXT, FILE, IMAGE, VIDEO
  fileUrl   String?
  isRead    Boolean  @default(false)
  schoolId  String
  chatId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([chatId])
}

model SchoolSettings {
  id               String   @id @default(cuid())
  schoolId         String   @unique
  academicYear     String   @default("2024-2025")
  semester         String   @default("Fall")
  gradingScale     String   @default("{\"A\": 90, \"B\": 80, \"C\": 70, \"D\": 60, \"F\": 0}")
  timezone         String   @default("UTC")
  onlineGrading    Boolean  @default(false)
  digitalLibrary   Boolean  @default(false)
  parentPortal     Boolean  @default(false)
  schoolEmail      String?
  schoolPhone      String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AuditLog {
  id        String         @id @default(cuid())
  schoolId  String
  userId    String
  action    String
  details   String?
  createdAt DateTime       @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
}

model Notification {
  id           String    @id @default(cuid())
  title        String
  message      String
  type         String
  contentType  String?
  contentId    String?
  priority     String    @default("normal")
  data         String?
  isRead       Boolean   @default(false)
  schoolId     String
  userId       String
  senderId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher  User   @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  students User[] @relation("ClassStudents")
  attendance Attendance[]
  schedules Schedule[]
  liveSessions LiveSession[]

  @@index([schoolId])
  @@index([teacherId])
}

model Attendance {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  classId      String
  date         DateTime
  status       String   // 'present', 'absent', 'late'
  checkInTime  String?
  checkOutTime String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class_ Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([date])
}

model Schedule {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  subject     String
  room        String?
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class_ Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([classId])
}

model LiveSession {
  id                String    @id @default(cuid())
  title             String
  description       String?
  schoolId          String
  classId           String
  teacherId         String
  roomCode          String    @unique
  startTime         DateTime
  endTime           DateTime?
  isActive          Boolean   @default(true)
  participantCount  Int       @default(0)
  maxParticipants   Int       @default(50)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class_  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@index([roomCode])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSessions LiveSession[]

  @@index([schoolId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      String
  schoolId  String
  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([code])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
