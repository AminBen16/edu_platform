// =======================
// DATABASE & GENERATOR
// =======================

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// =======================
// ENUMS
// =======================

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum MediaType {
  VIDEO
  AUDIO
  PDF
  IMAGE
  SCREEN_RECORDING
}

// =======================
// MODELS
// =======================

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subjects      Subject[]
  levels        Level[]
  topics        Topic[]
  lessons       Lesson[]
  media         Media[]
  quizzes       Quiz[]
  questions     Question[]
  attempts      QuizAttempt[]
  comments      Comment[]
  announcements Announcement[]
  chats         Chat[]
  messages      ChatMessage[]
}

model User {
  id            String    @id @default(cuid())
  schoolId      String
  role          Role
  name          String
  email         String
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdSubjects  Subject[]
  createdLevels    Level[]
  createdTopics    Topic[]
  createdLessons   Lesson[]
  createdMedia     Media[]
  createdQuizzes   Quiz[]
  createdQuestions Question[]
  quizAttempts     QuizAttempt[]
  comments         Comment[]
  sentMessages     ChatMessage[]
  chats            Chat[]         @relation("ChatUsers")
  announcements    Announcement[]

  @@unique([email, schoolId])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  levels Level[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Level {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  subjectId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  topics  Topic[]

  @@unique([name, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  levelId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([name, levelId])
  @@index([schoolId])
  @@index([levelId])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  schoolId    String
  topicId     String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  media    Media[]
  comments Comment[]
  quizzes  Quiz[]

  @@index([schoolId])
  @@index([topicId])
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  name      String
  size      Float
  schoolId  String
  lessonId  String?
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  author User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([lessonId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  schoolId  String
  lessonId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([lessonId])
}

model Quiz {
  id        String   @id @default(cuid())
  title     String
  schoolId  String
  lessonId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([schoolId])
  @@index([lessonId])
}

model Question {
  id        String   @id @default(cuid())
  text      String
  options   Json
  schoolId  String
  quizId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  score     Float
  answers   Json
  schoolId  String
  quizId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([quizId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  content   String
  schoolId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Chat {
  id        String   @id @default(cuid())
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users    User[]        @relation("ChatUsers")
  messages ChatMessage[]

  @@index([schoolId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  schoolId  String
  chatId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([chatId])
}
