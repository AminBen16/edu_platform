// Production Database Schema - Multi-School Education Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Multi-tenancy: Each school has isolated data
model School {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?  @map("logo_url")
  domain    String?  @unique // Custom domain per school
  settings  String? // School-specific settings (JSON string)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users       User[]
  teachers    Teacher[]
  students    Student[]
  lessons     Lesson[]
  quizzes     Quiz[]
  subjects    Subject[]
  classes     Class[]
  invitations Invitation[]
}

// User invitation system
model Invitation {
  id        String    @id @default(cuid())
  email     String
  name      String
  role      String
  schoolId  String    @map("school_id")
  code      String    @unique // Secure invitation code
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator  User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([email, code]) // Unique email per invitation code
}

// Account deletion requests
model DeletionRequest {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  token      String    @unique // Secure deletion token
  expiresAt  DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  requestedAt DateTime  @default(now()) @map("requested_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Audit logging for security
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  action    String      // LOGIN, LOGOUT, INVITE_CREATED, ACCOUNT_DELETED, etc.
  resource  String?     // Resource affected (user_id, school_id, etc.)
  details   String?       // Additional details (JSON string)
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Rate limiting for security
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // IP address or user ID
  count     Int      @default(1)
  windowEnd DateTime @map("window_end")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Base user model with role-based access
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?   // Optional for social login
  avatarUrl     String?   @map("avatar_url")
  role          String
  schoolId      String    @map("school_id")
  emailVerified DateTime? @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenancy: Users belong to schools
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Relations
  teacherProfile         Teacher?                 @relation("TeacherProfile")
  studentProfile         Student?                 @relation("StudentProfile")
  enrollments            Enrollment[]
  quizAttempts           QuizAttempt[]
  messages               Message[]
  LiveSessionParticipant LiveSessionParticipant[]
  invitations            Invitation[]
  deletionRequest        DeletionRequest?
  auditLogs              AuditLog[]
  notifications          Notification[]

  @@unique([email, schoolId]) // Unique email per school
}

// Teacher-specific profile
model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  schoolId       String   @map("school_id")
  department     String?
  bio            String?
  experience     Int? // Years of experience
  qualifications String? // Teaching qualifications (JSON string)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user        User          @relation("TeacherProfile", fields: [userId], references: [id], onDelete: Cascade)
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  classes     Class[]
  Quiz        Quiz[]
  Assignment  Assignment[]
  LiveSession LiveSession[]
}

// Student-specific profile
model Student {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  schoolId    String    @map("school_id")
  grade       String? // Grade level
  section     String? // Class section
  parentEmail String?   @map("parent_email")
  dateOfBirth DateTime? @map("date_of_birth")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user         User          @relation("StudentProfile", fields: [userId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  quizAttempts QuizAttempt[]
  Submission   Submission[]
}

// Subject/Course organization
model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique // Subject code like "MATH101"
  description String?
  schoolId    String   @map("school_id")
  color       String? // For UI theming
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]
}

// Class/Section management
model Class {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique // Class code like "10A"
  grade     String?
  capacity  Int? // Max students
  schoolId  String   @map("school_id")
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  lessons     Lesson[]
}

// Lesson content management
model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String?
  content     String? // Rich text content
  type        String @default("LESSON")
  videoUrl    String?    @map("video_url") // Recorded video URL
  documentUrl String?    @map("document_url") // Document URL
  duration    Int? // Duration in minutes
  order       Int? // For lesson sequencing
  isPublished Boolean    @default(false) @map("is_published")
  difficulty  String? // Difficulty level (string field)
  tags        String?   // Array of tags (JSON string)
  schoolId    String     @map("school_id")
  subjectId   String?    @map("subject_id")
  teacherId   String?    @map("teacher_id")
  classId     String?    @map("class_id")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher     Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  class       Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  resources   LessonResource[]
  assignments Assignment[]
}

// Lesson resources (PDFs, videos, etc.)
model LessonResource {
  id        String       @id @default(cuid())
  title     String
  type      String
  url       String // Cloud storage URL
  size      Int? // File size in bytes
  lessonId  String       @map("lesson_id")
  createdAt DateTime     @default(now())

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// Quiz and assessment system
model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String @default("ASSIGNMENT")
  timeLimit    Int?     @map("time_limit") // Minutes
  duration     Int? // Duration in minutes (alias for timeLimit)
  maxAttempts  Int      @default(1) @map("max_attempts") // Max attempts
  passingScore Float?   @map("passing_score") // Percentage
  isPublished  Boolean  @default(false) @map("is_published")
  difficulty   String? // Difficulty level (string field)
  schoolId     String   @map("school_id")
  subjectId    String?  @map("subject_id")
  teacherId    String?  @map("teacher_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher   Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attempts  QuizAttempt[]
  questions Question[]
}

// Quiz questions
model Question {
  id        String       @id @default(cuid())
  text      String
  type      String
  order     Int
  points    Float        @default(1.0)
  quizId    String       @map("quiz_id")
  createdAt DateTime     @default(now())

  // Relations
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
}

// Multiple choice options
model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int
  questionId String   @map("question_id")
  createdAt  DateTime @default(now())

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Student quiz attempts
model QuizAttempt {
  id          String    @id @default(cuid())
  score       Float?
  maxScore    Float     @map("max_score")
  completedAt DateTime? @map("completed_at")
  studentId   String    @map("student_id")
  quizId      String    @map("quiz_id")
  createdAt   DateTime  @default(now())

  // Relations
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
  User    User?    @relation(fields: [userId], references: [id])
  userId  String?
}

// Student answers
model Answer {
  id            String   @id @default(cuid())
  quizAttemptId String   @map("quiz_attempt_id")
  questionId    String   @map("question_id")
  selectedId    String?  @map("selected_id") // Selected option ID
  textAnswer    String?  @map("text_answer") // For text questions
  isCorrect     Boolean? @map("is_correct")
  createdAt     DateTime @default(now())

  // Relations
  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
}

// Student enrollments
model Enrollment {
  id         String           @id @default(cuid())
  studentId  String           @map("student_id")
  classId    String?          @map("class_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     String @default("ACTIVE")

  // Relations
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class    Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  User     User?   @relation(fields: [userId], references: [id])
  userId   String?
  Lesson   Lesson? @relation(fields: [lessonId], references: [id])
  lessonId String?
}

// Assignment system
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  maxScore    Float?    @map("max_score")
  lessonId    String?   @map("lesson_id")
  teacherId   String?   @map("teacher_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  submissions Submission[]
}

// Assignment submissions
model Submission {
  id           String   @id @default(cuid())
  content      String? // Text content
  fileUrl      String?  @map("file_url") // Cloud storage URL
  score        Float?
  submittedAt  DateTime @default(now()) @map("submitted_at")
  studentId    String   @map("student_id")
  assignmentId String   @map("assignment_id")
  createdAt    DateTime @default(now())

  // Relations
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

// Real-time chat system
model Message {
  id        String      @id @default(cuid())
  content   String
  type      String @default("TEXT")
  fileUrl   String?     @map("file_url") // Image/video attachment
  senderId  String      @map("sender_id")
  classId   String?     @map("class_id") // Class-specific chat
  isRead    Boolean     @default(false) @map("is_read")
  createdAt DateTime    @default(now())

  // Relations
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Live class sessions
model LiveSession {
  id          String    @id @default(cuid())
  title       String
  description String?
  roomCode    String    @unique @map("room_code") // WebRTC room code
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  isActive    Boolean   @default(true) @map("is_active")
  teacherId   String    @map("teacher_id")
  classId     String?   @map("class_id")
  createdAt   DateTime  @default(now())

  // Relations
  teacher      Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  participants LiveSessionParticipant[]
}

// Live session participants
model LiveSessionParticipant {
  id            String          @id @default(cuid())
  joinedAt      DateTime        @default(now()) @map("joined_at")
  leftAt        DateTime?       @map("left_at")
  sessionId     String          @map("session_id")
  participantId String          @map("participant_id")
  role          String @default("STUDENT")

  // Relations
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant User        @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// Note: Enums converted to String fields for SQLite compatibility

// Notification system
model Notification {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  type      String      // ASSIGNMENT, GRADE, ANNOUNCEMENT, REMINDER
  title     String
  message   String
  data      String?       // Additional notification data (JSON string)
  isRead    Boolean     @default(false) @map("is_read")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
