{
  "name": "db",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run prisma:generate:safe",
    "clean": "rm -rf dist",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:generate:safe": "node -e \"require('os').platform() === 'win32' ? console.log('Skipping Prisma generate on Windows (will run on Vercel Linux)') : require('child_process').execSync('prisma generate', {stdio: 'inherit'})\" || true",
    "postinstall": "npm run prisma:generate:safe || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts",
    "schema": "schema.prisma"
  }
}
